# MANITA Environment Configuration
# Supabase Project URL (From your Supabase Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable Key (Client-safe)
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Supabase Secret Key (Server / Admin only - NEVER expose in client bundles or public repositories!)
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
